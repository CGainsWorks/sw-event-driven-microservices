            "protoDescriptors": "",
            "protoFile": "syntax = \"proto3\";\n\npackage sw_edm.inventory.v1;\n\nimport \"google/protobuf/timestamp.proto\";\nimport \"sw_edm/common/v1/common.proto\";\n\n// Inventory owns one invariant: available stock is never negative, where availability is\n// on_hand minus reserved. Every RPC here either respects that invariant or refuses.\n//\n// ---------------------------------------------------------------------------\n// Business failure is not a transport error\n// ---------------------------------------------------------------------------\n// Every mutating RPC returns OK with an `outcome` enum in the response body when the\n// domain reaches a decision — including a decision the caller did not want, such as\n// insufficient stock. gRPC status codes are reserved for transport and programming\n// faults: unavailable, deadline exceeded, malformed request.\n//\n// The reason is retry policy. A generic interceptor that retries on non-OK status must\n// not retry a request the domain already answered — \"there are only two left\" will still\n// be true on the second attempt, and retrying it wastes a round trip and muddies the\n// trace. Encoding the domain answer in the body makes \"the call worked, the answer was\n// no\" distinguishable from \"the call did not work\", which is exactly the distinction the\n// saga's ambiguous-outcome handling depends on.\n//\n// ---------------------------------------------------------------------------\n// Idempotency\n// ---------------------------------------------------------------------------\n// Every mutating RPC carries an `idempotency_key` chosen by the caller and stable across\n// retries. Calling twice with the same key returns the same answer and changes state at\n// most once. This is what makes the saga safe to retry after a timeout, and it is the\n// reason a *failed* reservation still allocates a reservation_id: the second call must\n// return the same refusal rather than re-running the availability check against stock\n// that has since changed.\nservice InventoryService {\n  // Claim stock for an order. Time-limited: the claim lapses at the returned expires_at\n  // unless committed or released first.\n  rpc ReserveStock(ReserveStockRequest) returns (ReserveStockResponse);\n\n  // Give a claim back. Compensation for ReserveStock. Units become available again and\n  // the stock figures are left as if the reservation had never happened.\n  rpc ReleaseStock(ReleaseStockRequest) returns (ReleaseStockResponse);\n\n  // Turn a claim into a deduction. on_hand and reserved both fall, so availability is\n  // unchanged — the units simply stop being ours. This is the last forward step of the\n  // fulfilment saga and the one with no cheap compensation.\n  rpc CommitReservation(CommitReservationRequest) returns (CommitReservationResponse);\n\n  // Read a reservation's current state.\n  //\n  // This exists for one purpose: resolving an ambiguous outcome. When a ReserveStock call\n  // times out, the caller does not know whether the reservation was made. It must not\n  // guess. It calls this with the same idempotency_key and asks the service that owns the\n  // truth. See docs/sagas.md.\n  rpc GetReservation(GetReservationRequest) returns (GetReservationResponse);\n}\n\n// State of a reservation. FAILED is a real, persisted state, not the absence of a record:\n// a refused reservation is remembered so that a retry gets the same refusal.\nenum ReservationState {\n  RESERVATION_STATE_UNSPECIFIED = 0;\n  RESERVATION_STATE_HELD = 1;\n  RESERVATION_STATE_COMMITTED = 2;\n  RESERVATION_STATE_RELEASED = 3;\n  RESERVATION_STATE_EXPIRED = 4;\n  RESERVATION_STATE_FAILED = 5;\n}\n\n// Why stock was released. Recorded so that a release during compensation can be told\n// apart from one caused by the expiry sweeper when reading the history back.\nenum ReleaseReason {\n  RELEASE_REASON_UNSPECIFIED = 0;\n  RELEASE_REASON_COMPENSATION = 1;\n  RELEASE_REASON_ORDER_CANCELLED = 2;\n}\n\nmessage ReserveStockRequest {\n  sw_edm.common.v1.RequestContext context = 1;\n\n  // Stable across retries of the same logical attempt. Conventionally\n  // \"<order_id>:reserve_stock:<attempt>\", but inventory treats it as opaque.\n  string idempotency_key = 2;\n\n  string order_id = 3;\n\n  // At least one line. SKUs are unique within a request; a duplicate SKU is\n  // INVALID_ARGUMENT rather than being silently summed, because summing would hide a\n  // caller bug that produces a double reservation.\n  repeated sw_edm.common.v1.StockLine lines = 4;\n\n  // Requested lifetime of the claim. Inventory may shorten it but never extend it, and\n  // returns the value it actually applied. Zero means \"use the service default\".\n  //\n  // The caller asks rather than dictates because inventory is the only party that knows\n  // its own sweeper interval, and a TTL shorter than that interval cannot be honoured.\n  uint32 ttl_seconds = 5;\n}\n\nmessage ReserveStockResponse {\n  enum Outcome {\n    OUTCOME_UNSPECIFIED = 0;\n\n    // Claim held. reservation_id, expires_at and state are populated.\n    OUTCOME_RESERVED = 1;\n\n    // One or more SKUs were short. `shortfalls` lists every one of them, not just the\n    // first, so the caller learns everything wrong with the request in one round trip.\n    OUTCOME_INSUFFICIENT_STOCK = 2;\n\n    // A SKU in the request does not exist. Distinct from insufficient stock: this is a\n    // caller error that will never succeed, whereas insufficient stock might.\n    OUTCOME_UNKNOWN_SKU = 3;\n  }\n\n  Outcome outcome = 1;\n\n  // Always populated, including on failure. Inventory allocates the id and records the\n  // attempt before deciding, so that a retry resolves to this same reservation.\n  string reservation_id = 2;\n\n  ReservationState state = 3;\n\n  // Populated when outcome is OUTCOME_RESERVED. This is the effective expiry, which may\n  // be sooner than the requested ttl_seconds implies.\n  google.protobuf.Timestamp expires_at = 4;\n\n  // Populated when outcome is OUTCOME_INSUFFICIENT_STOCK or OUTCOME_UNKNOWN_SKU.\n  repeated sw_edm.common.v1.Shortfall shortfalls = 5;\n\n  // True when this response was served from the idempotency record of an earlier\n  // identical call rather than by doing the work again.\n  //\n  // Purely observational — the caller must behave identically either way. It exists so\n  // that the failure injection tests can prove deduplication actually happened rather\n  // than inferring it from stock levels that would look the same either way.\n  bool deduplicated = 6;\n}\n\nmessage ReleaseStockRequest {\n  sw_edm.common.v1.RequestContext context = 1;\n  string idempotency_key = 2;\n  string reservation_id = 3;\n  ReleaseReason reason = 4;\n}\n\nmessage ReleaseStockResponse {\n  enum Outcome {\n    OUTCOME_UNSPECIFIED = 0;\n\n    // Released now, or already released by an earlier call. Both are success: a\n    // compensation that finds its work already done has succeeded, and treating that as\n    // an error would make retrying compensation unsafe.\n    OUTCOME_RELEASED = 1;\n\n    // The reservation was already committed. Releasing it is impossible — the units are\n    // gone. This is a genuine saga bug and the caller must not paper over it.\n    OUTCOME_ALREADY_COMMITTED = 2;\n\n    // No such reservation. Also treated as success by callers compensating a step that\n    // may never have run, but reported distinctly so that the difference is visible in a\n    // trace rather than being guessed at.\n    OUTCOME_NOT_FOUND = 3;\n  }\n\n  Outcome outcome = 1;\n  ReservationState state = 2;\n  bool deduplicated = 3;\n}\n\nmessage CommitReservationRequest {\n  sw_edm.common.v1.RequestContext context = 1;\n  string idempotency_key = 2;\n  string reservation_id = 3;\n}\n\nmessage CommitReservationResponse {\n  enum Outcome {\n    OUTCOME_UNSPECIFIED = 0;\n\n    OUTCOME_COMMITTED = 1;\n\n    // The claim lapsed before the saga got here. The units may since have been sold to\n    // someone else, so inventory refuses rather than deducting stock it no longer holds.\n    //\n    // This turns a potential oversell into a cancelled order, which is the correct trade:\n    // an order the customer does not get is recoverable, an oversell is not.\n    OUTCOME_EXPIRED = 2;\n\n    // Released already, by compensation or by a duplicate release. Nothing to commit.\n    OUTCOME_RELEASED = 3;\n\n    OUTCOME_NOT_FOUND = 4;\n  }\n\n  Outcome outcome = 1;\n  ReservationState state = 2;\n  bool deduplicated = 3;\n}\n\nmessage GetReservationRequest {\n  sw_edm.common.v1.RequestContext context = 1;\n\n  // Look up by reservation_id when it is known, or by idempotency_key when it is not —\n  // which is the case that matters, because a caller resolving a timed-out ReserveStock\n  // never received the reservation_id. Exactly one must be set.\n  oneof lookup {\n    string reservation_id = 2;\n    string idempotency_key = 3;\n  }\n}\n\nmessage GetReservationResponse {\n  // False when no reservation matches. Distinguished from an error so that \"the request\n  // never arrived\" is answerable, which is the entire reason this RPC exists.\n  bool found = 1;\n\n  string reservation_id = 2;\n  string order_id = 3;\n  ReservationState state = 4;\n  repeated sw_edm.common.v1.StockLine lines = 5;\n  google.protobuf.Timestamp expires_at = 6;\n  google.protobuf.Timestamp created_at = 7;\n}\n"
          }
        },
        "name": "protobuf",
        "version": "0.8.0"
      }
    ]
  },
