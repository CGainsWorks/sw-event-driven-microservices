{
  "$comment": "Events that MUST be rejected. A schema that accepts everything is worthless, so the test suite proves the negative as well as the positive: every case here is asserted to fail validation against the named schema, and the test fails if any of them passes. `expect_error_at` is the JSON Pointer the validator is expected to flag; it is checked so that a case cannot pass for the wrong reason.",

  "cases": [
    {
      "name": "missing-event-id",
      "schema": "orders.v1.OrderPlaced",
      "why": "event_id is the deduplication key. An event without one cannot be deduplicated and must never enter the system.",
      "expect_error_at": "",
      "event": {
        "event_type": "orders.v1.OrderPlaced",
        "event_version": 1,
        "occurred_at": "2026-03-14T09:15:00.000Z",
        "aggregate_id": "3f2b9c14-7e5a-4d3b-9c8e-1a2b3c4d5e6f",
        "aggregate_type": "order",
        "correlation_id": "7a1b2c3d-4e5f-4a6b-8c9d-0e1f2a3b4c5d",
        "producer": "orders",
        "data": {
          "order_id": "3f2b9c14-7e5a-4d3b-9c8e-1a2b3c4d5e6f",
          "customer_id": "8c1d4e2a-5b6f-4a7c-8d9e-0f1a2b3c4d5e",
          "customer_email": "ada@example.com",
          "lines": [{ "sku": "SKU-WIDGET-01", "quantity": 1, "unit_amount": { "amount_minor": 1250, "currency": "GBP" } }],
          "total_amount": { "amount_minor": 1250, "currency": "GBP" },
          "placed_at": "2026-03-14T09:15:00.000Z"
        }
      }
    },
    {
      "name": "unknown-envelope-field",
      "schema": "orders.v1.OrderPlaced",
      "why": "The envelope is closed. A producer that invents a top-level field is expressing something no consumer agreed to read, and silently accepting it lets the contract drift.",
      "expect_error_at": "",
      "event": {
        "event_id": "01000000-0000-4000-8000-000000000001",
        "event_type": "orders.v1.OrderPlaced",
        "event_version": 1,
        "occurred_at": "2026-03-14T09:15:00.000Z",
        "aggregate_id": "3f2b9c14-7e5a-4d3b-9c8e-1a2b3c4d5e6f",
        "aggregate_type": "order",
        "correlation_id": "7a1b2c3d-4e5f-4a6b-8c9d-0e1f2a3b4c5d",
        "producer": "orders",
        "tenant_id": "acme",
        "data": {
          "order_id": "3f2b9c14-7e5a-4d3b-9c8e-1a2b3c4d5e6f",
          "customer_id": "8c1d4e2a-5b6f-4a7c-8d9e-0f1a2b3c4d5e",
          "customer_email": "ada@example.com",
          "lines": [{ "sku": "SKU-WIDGET-01", "quantity": 1, "unit_amount": { "amount_minor": 1250, "currency": "GBP" } }],
          "total_amount": { "amount_minor": 1250, "currency": "GBP" },
          "placed_at": "2026-03-14T09:15:00.000Z"
        }
      }
    },
    {
      "name": "wrong-event-type-for-schema",
      "schema": "orders.v1.OrderPlaced",
      "why": "Each schema pins event_type with a const. This is what stops a consumer validating an OrderConfirmed against the OrderPlaced schema and concluding all is well.",
      "expect_error_at": "/event_type",
      "event": {
        "event_id": "01000000-0000-4000-8000-000000000001",
        "event_type": "orders.v1.OrderConfirmed",
        "event_version": 1,
        "occurred_at": "2026-03-14T09:15:00.000Z",
        "aggregate_id": "3f2b9c14-7e5a-4d3b-9c8e-1a2b3c4d5e6f",
