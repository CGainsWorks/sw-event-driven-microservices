{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CGainsWorks/sw-event-driven-microservices/events/schemas/inventory.v1.StockReleased.schema.json",
  "title": "inventory.v1.StockReleased",
  "description": "A claim was given back before it was committed. `reserved` falls by the released quantities and the units become available to other orders again. This is a true undo — releasing a reservation leaves no trace in the stock figures, which is exactly why stock is reserved before payment is authorized.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "inventory.v1.StockReleased" },
        "aggregate_type": { "const": "reservation" },
        "producer": { "const": "inventory" },
        "data": {
          "type": "object",
          "properties": {
            "reservation_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "order_id": { "$ref": "common.schema.json#/$defs/uuid" },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "common.schema.json#/$defs/stock_line" }
            },
            "reason": { "$ref": "common.schema.json#/$defs/release_reason" },
            "released_at": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "required": ["reservation_id", "order_id", "lines", "reason", "released_at"],
          "additionalProperties": false
        }
      }
    }
  ]
}
