# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# --- Go ---------------------------------------------------------------------
# Compiled binaries. Services build to ./bin inside their own directory.
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Go test and coverage output
*.test
*.out
coverage.txt
coverage.html

# --- Generated code ---------------------------------------------------------
# Protobuf output is generated by `buf generate` and NOT committed. Committing it
# invites a diff where the .proto and the generated code disagree, and there is no
# way to tell which one is right. `make proto` regenerates; CI regenerates and fails
# if the result differs from what the .proto files imply.
proto/gen/

# --- Test and tooling output ------------------------------------------------
# Pact files are generated by consumer test runs. The checked-in source of truth is the
# test, not the pact: a stale pact that looks authoritative is worse than no pact, because
# it would let a provider "pass" against expectations a consumer stopped having.
#
# Matched anywhere rather than at one fixed path — a misconfigured dir in a test writes
# them somewhere unexpected, and the first sign of it is a generated artefact in a commit.
**/pacts/
**/pact-logs/
contracts/logs/
tests/chaos/results/*.json
!tests/chaos/results/.gitkeep
.nyc_output/

# --- Local environment ------------------------------------------------------
.env
.env.local
*.local.yml
docker-compose.override.yml

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
